# Buildroot options removed for the NanoKVM image: the official image 1.4.3 has none of their
# files (measured against the baseline build's per-package file lists, 2026-11-26).
BR2_PACKAGE_QT5
BR2_PACKAGE_QT5BASE_FONTCONFIG
BR2_PACKAGE_QT5BASE_HARFBUZZ
BR2_PACKAGE_QT5BASE_GIF
BR2_PACKAGE_QT5BASE_JPEG
BR2_PACKAGE_QT5BASE_PNG
BR2_PACKAGE_QT5BASE_DBUS
BR2_PACKAGE_QT5BASE_ICU
BR2_PACKAGE_QT5BASE_TSLIB
BR2_PACKAGE_QT5CHARTS
BR2_PACKAGE_QT5IMAGEFORMATS
BR2_PACKAGE_QT5LOCATION
BR2_PACKAGE_QT5SVG
BR2_PACKAGE_PYTHON_PYQT5
BR2_PACKAGE_PYTHON_PYQT5_SIP
BR2_PACKAGE_PYTHON_FLASK_BABEL
BR2_PACKAGE_COMIX_CURSORS
BR2_PACKAGE_OBSIDIAN_CURSORS
BR2_PACKAGE_BITSTREAM_VERA
BR2_PACKAGE_CANTARELL
BR2_PACKAGE_DEJAVU
BR2_PACKAGE_FONT_AWESOME
BR2_PACKAGE_INCONSOLATA
BR2_PACKAGE_LIBERATION
BR2_PACKAGE_WQY_ZENHEI
BR2_PACKAGE_HICOLOR_ICON_THEME
BR2_PACKAGE_LFTP
BR2_PACKAGE_LFTP_PROTO_FISH
BR2_PACKAGE_LFTP_PROTO_HTTP
BR2_PACKAGE_LFTP_PROTO_SFTP
BR2_PACKAGE_VSFTPD
BR2_PACKAGE_ANDROID_TOOLS
BR2_PACKAGE_FBV
BR2_PACKAGE_LIBKRB5
# bind: the official image has only its client tools (delv, nslookup; BusyBox has nslookup too).
# bind 9.20 (Buildroot 2025.02) needs liburcu, whose tests do not link with the SDK's GCC 10
# toolchain ("read-only segment has dynamic relocations"); a DNS suite is not needed on the KVM.
BR2_PACKAGE_BIND
BR2_PACKAGE_BIND_TOOLS
# gdb / gdbserver: a debugger has no use on the KVM (the official image has them), and gdb 15
# (Buildroot 2025.02) does not build against the SDK musl headers (no ELF_NFPREG).
BR2_PACKAGE_GDB
BR2_PACKAGE_GDB_SERVER
BR2_PACKAGE_GDB_DEBUGGER
BR2_PACKAGE_GDB_TUI
BR2_PACKAGE_GDB_PYTHON
BR2_PACKAGE_HOST_GDB
BR2_PACKAGE_HOST_GDB_TUI
BR2_PACKAGE_HOST_GDB_PYTHON3
BR2_PACKAGE_HOST_GDB_SIM
